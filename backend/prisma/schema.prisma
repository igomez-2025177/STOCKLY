generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum MotivoMovimiento {
  COMPRA
  VENTA
  PERDIDA
  DEVOLUCION
  AJUSTE
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  correo        String       @unique
  password      String?
  googleId      String?      @unique
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  categorias  Categoria[]
  proveedores Proveedor[]
  productos   Producto[]
  movimientos Movimiento[]

  @@map("usuarios")
}

model Categoria {
  id            Int        @id @default(autoincrement())
  nombre        String
  descripcion   String?
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  usuarioId     Int

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([usuarioId, nombre])
  @@map("categorias")
}

model Proveedor {
  id            Int          @id @default(autoincrement())
  nombre        String
  contacto      String?
  telefono      String?
  correo        String?
  nit           String?
  activo        Boolean      @default(true)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  usuarioId     Int

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  productos   Producto[]
  movimientos Movimiento[]

  @@unique([usuarioId, nombre])
  @@map("proveedores")
}

model Producto {
  id            Int          @id @default(autoincrement())
  nombre        String
  descripcion   String?
  ubicacion     String?
  precioCompra  Decimal      @default(0) @db.Decimal(10, 2)
  precioVenta   Decimal      @db.Decimal(10, 2)
  stockActual   Int          @default(0)
  stockMinimo   Int          @default(0)
  activo        Boolean      @default(true)
  categoriaId   Int
  proveedorId   Int?
  usuarioId     Int
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  proveedor   Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  movimientos Movimiento[]

  @@unique([usuarioId, nombre])
  @@index([usuarioId, activo])
  @@index([categoriaId])
  @@index([proveedorId])
  @@map("productos")
}

model Movimiento {
  id              Int              @id @default(autoincrement())
  tipo            TipoMovimiento
  motivo          MotivoMovimiento
  cantidad        Int
  stockResultante Int
  precioUnitario  Decimal?         @db.Decimal(10, 2)
  nota            String?
  fecha           DateTime         @default(now())
  productoId      Int
  usuarioId       Int
  proveedorId     Int?

  producto  Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  @@index([usuarioId, fecha])
  @@index([productoId])
  @@index([proveedorId])
  @@index([tipo, motivo])
  @@map("movimientos")
}